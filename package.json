{
  "name": "restaurant-pos",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first, single-writer point-of-sale system for a single restaurant in Pakistan.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "build:frontend": "npm run build --workspace apps/frontend",
    "seed": "npm run seed --workspace apps/server",
    "menu:import": "npm run menu:import --workspace apps/server --",
    "reset:sales": "npm run reset:sales --workspace apps/server --",
    "start": "npm run start --workspace apps/server"
  },
  "overrides": {
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
