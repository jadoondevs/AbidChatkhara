# Copy this file to .env (gitignored) and adjust for this restaurant's
# network. Never commit the real .env.

# HTTP port the server listens on (also serves the built frontend PWA).
POS_PORT=4000

# Bind address. 0.0.0.0 so tablets on the restaurant's Wi-Fi can reach it.
POS_HOST=0.0.0.0

# Path to the SQLite database file. Back this file up (see README.md).
POS_DB_PATH=./data/pos.sqlite

# The receipt printer's IP address on the restaurant's local network.
# Leave unset to run without printing (bill/receipt print calls fail
# with a clear error instead of crashing anything else).
POS_PRINTER_HOST=

# The printer's raw ESC/POS TCP port. 9100 is the standard "JetDirect"
# port almost every network thermal printer listens on by default.
POS_PRINTER_PORT=9100

# Where the built PWA lives. Defaults to apps/frontend/dist, so
# `npm run build:frontend` is all it normally takes. If that directory
# has no index.html the server runs API-only — which is exactly what you
# want when running `npm run dev:frontend` against it instead.
# POS_FRONTEND_DIR=
