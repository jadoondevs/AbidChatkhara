# Copy this file to .env (gitignored) and adjust for this restaurant's
# network. Never commit the real .env — it will eventually hold printer
# IP addresses.

# HTTP port the server listens on (also serves the built frontend PWA).
POS_PORT=4000

# Bind address. 0.0.0.0 so tablets on the restaurant's Wi-Fi can reach it.
POS_HOST=0.0.0.0

# Path to the SQLite database file. Back this file up (see README.md).
POS_DB_PATH=./data/pos.sqlite
